{
  "name": "dsh-pet-studio",
  "version": "0.2.0",
  "type": "module",
  "description": "Turn a photo into a Q-style DSH pet: cut out, build a dsh-pet pack (avatar, memes, persona), and keep the built-in pets working. · 把照片做成 Q 版桌宠，内置宠物照常可用。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-pet",
    "pet",
    "q-style"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "sharp": "^0.34.0"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
